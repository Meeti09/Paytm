# ==============================================================
# Paytm Pulse — environment
#
# Copy to .env and paste your own keys. Never commit .env.
# Every integration below is OPTIONAL: with all of them blank the
# full demo still runs on deterministic local fallbacks, and the UI
# shows which mode each integration is in.
#
# Secrets live here, on the backend only. Nothing in this file is
# exposed to the browser except NEXT_PUBLIC_* values.
# ==============================================================

# ------------------------------
# Application
# ------------------------------
NODE_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Read by the Next.js frontend. Safe to expose — it is just a URL.
# Put this in frontend/.env.local for the frontend to pick it up.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------
# Database
# ------------------------------
# Blank -> local SQLite file at backend/pulse.db (zero setup).
# Or point at PostgreSQL:
#   postgresql+psycopg://user:password@localhost:5432/paytm_pulse
DATABASE_URL=

# ------------------------------
# LLM — the reasoning layer
#   provider: anthropic | openai | openai_compatible | sarvam
#   Leave blank to use the deterministic reasoner.
# ------------------------------
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ------------------------------
# Sarvam — India-native language layer
# ------------------------------
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-m

# ------------------------------
# Cognee — contextual memory
# ------------------------------
COGNEE_API_URL=
COGNEE_API_KEY=

# ------------------------------
# n8n — the execution layer
#   Blank -> the local workflow runner executes the same
#   workflow steps in-process.
# ------------------------------
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_PREFIX=/webhook/paytm-pulse

# ------------------------------
# Internal service auth
#   Guards the mutating /paytm/* endpoints so only the execution
#   layer can call them. Generated per process if left blank; set
#   it explicitly when running n8n so both sides agree.
# ------------------------------
INTERNAL_API_KEY=

# ------------------------------
# Demo policy
#   Hackathon demo policy. NOT Paytm's production policy.
# ------------------------------
REFUND_APPROVAL_THRESHOLD=1000
ACCOUNT_ACTIONS_REQUIRE_APPROVAL=true
NEGATIVE_SENTIMENT_REQUIRES_REVIEW=true
IRREVERSIBLE_ACTIONS_REQUIRE_APPROVAL=true
UNKNOWN_PERMISSIONS_REQUIRE_APPROVAL=true

# ------------------------------
# Grow tuning
# ------------------------------
LEAD_QUALIFICATION_THRESHOLD=75
LEAD_OUTREACH_THRESHOLD=80

# ------------------------------
# Demo
#   agent_step_delay_ms paces the live timeline for a stage demo.
# ------------------------------
DEMO_MODE=true
AGENT_STEP_DELAY_MS=550
